# ============================================================
# WatchMend 配置(cp .env.example .env 后按需修改)
# 必填规则:至少配置一个通知渠道(飞书或 Telegram/ntfy/webhook 任一);其余全部有合理默认值。
# 想关掉某一层:SENTINEL_PROMETHEUS_URL/SENTINEL_LOKI_URL 留空即可。
# ============================================================

# ----- 飞书通知 -----
# 外部依赖状态群自定义机器人(群设置 → 群机器人 → 自定义机器人;建议开「签名校验」)
# 不再强制必填:至少配置一个通知渠道即可(飞书或下方任一)。不用飞书就留空。
# 格式:https://open.feishu.cn/open-apis/bot/v2/hook/<你的机器人 token>
FEISHU_VENDOR_WEBHOOK=
FEISHU_VENDOR_SIGN_SECRET=
# 内部巡检群独立机器人(日报/事件/诊断卡);留空=与上面共用一个群
FEISHU_PATROL_WEBHOOK=
FEISHU_PATROL_SIGN_SECRET=

# ── 通知渠道(子项目②)──────────────────────────────────
# 广播语义:配了哪几个就同时发哪几个。飞书之外,海外自托管可只配任一渠道。
# 飞书/Telegram/ntfy/webhook 至少配置一个,否则启动失败。
# 影子验证可设 shadow：所有通知只写日志、不外发，也不要求配置渠道。
SENTINEL_NOTIFICATION_MODE=live

# Telegram(BOT_TOKEN 与 CHAT_ID 同时非空才启用;群组 chat_id 为负数)
SENTINEL_TELEGRAM_BOT_TOKEN=
SENTINEL_TELEGRAM_CHAT_ID=

# ntfy(完整 topic URL;可选 Bearer token 用于受保护 topic / 自建)
SENTINEL_NTFY_URL=
SENTINEL_NTFY_TOKEN=

# 通用 webhook(机器消费 JSON:{kind,severity,title,detail,fields,subject,ts,data};可选 Bearer)
SENTINEL_WEBHOOK_URL=
SENTINEL_WEBHOOK_TOKEN=

# ----- 外部状态页监控 -----
# 轮询哪些厂商的官方 status page(逗号分隔)
SENTINEL_PROVIDERS=anthropic,openai,github,cloudflare,google_cloud
SENTINEL_POLL_INTERVAL=60
# 事件播报粒度:phase(状态翻转才发)/ update(每条更新都发)
SENTINEL_INCIDENT_VERBOSITY=phase
# 抓取连续失败 N 次才报(吸收网络抖动)
SENTINEL_FAIL_THRESHOLD=3
# 同一厂商非紧急状态卡最小间隔；重大故障与恢复直通。0=关闭限速。
SENTINEL_PROVIDER_CARD_MIN_GAP_S=600
# 上游状态 AI 编辑器（与内部事件诊断 LLM 相互独立）：
# shadow=只审计；enrich=改写卡片但不静默；gate=可静默非紧急变化。
# 推荐接 LiteLLM，使用专用虚拟密钥；模型示例：gemini/gemini-2.5-flash。
SENTINEL_EDITOR_MODE=off
SENTINEL_EDITOR_BASE_URL=
SENTINEL_EDITOR_API_KEY=
SENTINEL_EDITOR_MODEL=
SENTINEL_EDITOR_TIMEOUT_SECONDS=15
# 每日心跳汇总卡(存在感+确认存活):发送小时与时区偏移
SENTINEL_HEARTBEAT_ENABLED=true
SENTINEL_HEARTBEAT_HOUR=9
SENTINEL_HEARTBEAT_UTC_OFFSET=8

# ----- 内部巡检:接入点 -----
# 探针清单文件(容器内路径;compose 已把 ./services.yaml 挂到该处;缺失=只监控外部状态页)
SENTINEL_SERVICES_FILE=services.yaml
SENTINEL_PROBE_INTERVAL=300
# Prometheus / Loki 地址(容器网络内可达);留空=关闭对应扫描层
# 默认留空:启动时 discover 探到 prom/loki 容器会在日志提示要填的值,按提示填后重启即可
# (demo 栈在 docker-compose.demo.yml 里已直接注入,无需在此填)
SENTINEL_PROMETHEUS_URL=
SENTINEL_LOKI_URL=
SENTINEL_SCAN_INTERVAL=900

# ----- 内部巡检:阈值(默认值通常够用) -----
# 同一 (规则, 对象) 的事件冷却小时数
SENTINEL_COOLDOWN_HOURS=6
# 数据源连续失败 N 次才发巡检失败卡
SENTINEL_SCAN_FAIL_THRESHOLD=3
# 探针连续失败 N 次判服务异常
SENTINEL_PROBE_FAIL_STREAK=3
# 延迟告警:1h p95 超七日基线的倍数 且 超出绝对量(两者都满足才报)
SENTINEL_LATENCY_RATIO=2.0
SENTINEL_LATENCY_MARGIN_MS=500.0
SENTINEL_LATENCY_MIN_SAMPLES=6
# 错误日志激增:超七日同时段均值倍数 且 超绝对条数
SENTINEL_LOG_SPIKE_RATIO=3.0
SENTINEL_LOG_SPIKE_MIN=10
# 新错误指纹：捕捉未达到尖峰阈值的低频/单条错误，按容器+归一化指纹去重。
SENTINEL_ERROR_ALERT_ENABLED=false
SENTINEL_ERROR_ALERT_INTERVAL=300
SENTINEL_ERROR_WINDOW_MINUTES=10
SENTINEL_ERROR_MAX_PER_CYCLE=8
SENTINEL_ERROR_QUERY_LIMIT=1000
SENTINEL_ERROR_CONTAINERS=.+
SENTINEL_ERROR_IGNORE_PATTERNS=
# 必须与当前容器名一致，避免 WatchMend 扫描自己的事件日志形成反馈环。
SENTINEL_SELF_CONTAINER=watchmend
# 磁盘:使用率阈值 / 线性外推 N 天内写满则预警
SENTINEL_DISK_USAGE_PCT=85.0
SENTINEL_DISK_FORECAST_DAYS=14
# 内存:容器持续 15 分钟超 limit 百分比 / 宿主机 swap 使用率
SENTINEL_CONTAINER_MEM_PCT=90.0
SENTINEL_SWAP_PCT=80.0

# ----- 内部巡检:可选检查(默认关闭/跳过) -----
# 存储中间件兜底 up 指标:CSV "metric:展示名",如 pg_up:postgres,redis_up:redis
# 需要对应 exporter(postgres-exporter/redis-exporter 等);留空=跳过本检查
SENTINEL_MIDDLEWARE_METRICS=
# 备份新鲜度:容器内备份目录(compose 把宿主机目录挂到这里);目录缺失或为空=自动跳过
SENTINEL_BACKUP_DIR=/backups/postgresql
SENTINEL_BACKUP_MAX_AGE_HOURS=28
# Restic Pushgateway 指标检查；0=关闭，启用时填允许的最大成功间隔小时数。
SENTINEL_RESTIC_BACKUP_MAX_AGE_HOURS=0
# 公网证书临期检查:逗号分隔域名,如 a.example.com,b.example.com;留空=跳过
SENTINEL_CERT_DOMAINS=
SENTINEL_CERT_MIN_DAYS=14

# ----- 日报与存储 -----
# 体检日报发送小时(与心跳独立)
SENTINEL_REPORT_HOUR=9
# 非硬告警进入 09:00 日报和 18:00 摘要；默认关闭以保持逐事件实时通知兼容。
SENTINEL_DEFER_NONURGENT=false
SENTINEL_EVENING_DIGEST_HOUR=18
SENTINEL_PROBE_RETENTION_DAYS=30
SENTINEL_DB_PATH=/data/sentinel.db

# ----- 证据台只读面板(子项目③) -----
# localhost-only SSR 面板:状态机时间线 / 诊断证据链 / 安全姿态;沿用 127.0.0.1:8765(与编排 API 同端口)。
# 默认开;偏执用户设 false 可整体不注册面板路由。要对外暴露请自己加反代 + 鉴权(面板本身不带鉴权)。
SENTINEL_PANEL_ENABLED=true

# ----- LLM 诊断与日报 AI 总结(可选;留空=整层关闭) -----
# 任何 OpenAI-compatible 端点都行:openai/deepseek/moonshot/glm/gemini/ollama/vllm/litellm…
# 各平台 base_url 与可用模型见 README「LLM 诊断」表;诊断依赖 function calling,选模型须确认支持工具调用。
# 启用需同时填 LLM_BASE_URL 和 LLM_MODEL(只填一个不生效,启动日志会警告);
# 开启后事件自动跑容器内诊断 tool 循环(查 prometheus/loki/docker)出诊断卡,日报附 AI 总结
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# ----- docker 容器巡检 + 只读诊断工具 -----
# 容器停止/不健康/OOM 检测 + LLM 诊断的 ps/logs/inspect 工具都走这条连接。
# 与其他接入点不同:本层默认开启——下方已预填 compose 里的 docker-proxy 边车地址
# (只读 TCP,本容器不挂裸 socket)。要整层关闭:清空本值,并注释掉 docker-compose.yml
# 的 docker-proxy service、sentinel 的 depends_on/docker_proxy 网络(见该文件内注释)。
SENTINEL_DOCKER_HOST=tcp://docker-proxy:2375
# 老路径(不推荐):裸挂 unix:// socket = 宿主机级 root 权限。要走老路径就改成:
#   SENTINEL_DOCKER_HOST=unix:///var/run/docker.sock
#   并在 compose 取消注释 - /var/run/docker.sock:/var/run/docker.sock:ro
# docker 巡检周期(秒)
SENTINEL_DOCKER_SCAN_INTERVAL=60
# crash-loop 检测(docker-only 盲区:容器反复崩溃→被拉起,极少卡在 exited 被 container_down 抓到)。
# 窗口 W 内 RestartCount 增长 >= 阈值 N 即发一张 point 卡。接了 prom+cadvisor 时此规则自动让位
# 给指标层 container_restart(不双发);默认值适配 60s 巡检(W=600s≈10 个 tick)。
SENTINEL_DOCKER_CRASHLOOP_WINDOW=600
SENTINEL_DOCKER_CRASHLOOP_THRESHOLD=3
# 排除监控的容器名(逗号分隔);watchmend 自身与 docker-proxy 已自动排除
SENTINEL_DOCKER_EXCLUDE=
# 【弃用】旧字段,仅为向后兼容保留;请改用上面的 SENTINEL_DOCKER_HOST。
# 设了它且未设 SENTINEL_DOCKER_HOST 时会回退映射为 unix://<本值>,启动日志会警告。
SENTINEL_DOCKER_SOCKET=
# 进阶:诊断轮询周期(秒)/单次请求超时/工具调用轮数上限
SENTINEL_DIAG_INTERVAL=120
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOOL_ROUNDS=8

# ----- LLM 诊断编排 API(可选,宿主机 agent 编排路径) -----
# 不用容器内直连、而想接自己的 agent runner(见 host/ 目录)时走这条路;
# 与上面的直连层二选一,同时开会重复诊断。
# 编排 API 写端点鉴权 token;部署时务必设随机值(openssl rand -hex 16)
SENTINEL_DIAG_TOKEN=

# ----- Codex 生命周期通知入口(可选) -----
# 独立 token；空=两个 /notifications/codex* 入口都返回 404。不要复用飞书 webhook。
# 生成示例:openssl rand -hex 32
SENTINEL_CODEX_INGEST_TOKEN=
# 幂等回执只存 thread+turn 事件键的 SHA-256，不存任务或结果正文。
SENTINEL_CODEX_RECEIPT_RETENTION_DAYS=30
# 生命周期 Hook 候选等待 15 分钟；期间有用户输入/审批后执行/会话结束则取消。
SENTINEL_CODEX_HOOK_GRACE_SECONDS=900
# 正常完成仅在回合耗时达到 3 分钟时才进入候选；需审批/输入/失败不受此阈值限制。
SENTINEL_CODEX_LONG_TURN_SECONDS=180
# 后台检查到期候选的周期。
SENTINEL_CODEX_HOOK_POLL_SECONDS=1

# ----- Codex 共享额度 reset 监控(可选) -----
# 独立领域 Job；复用内部巡检广播（FEISHU_PATROL_*，留空则回退 FEISHU_VENDOR_*）。
# 默认仅采集公开结构化来源。概率预测不会触发疑似预告。
SENTINEL_CODEX_RESET_ENABLED=false
# 主结构化来源轮询周期，最小 30 秒；生产建议 60 秒。
SENTINEL_CODEX_RESET_POLL_SECONDS=60
# 明确预告的预计截止时间超过此宽限后，升级 delayed 并单独通知。
SENTINEL_CODEX_RESET_DELAY_GRACE_SECONDS=600
# 首次启用时不补发超过此时长的旧事件。
SENTINEL_CODEX_RESET_NOTIFY_MAX_AGE_HOURS=24
# /health 认为来源内容新鲜的最长秒数。
SENTINEL_CODEX_RESET_FRESHNESS_SECONDS=7200
# SQLite 单实例租约；应大于轮询周期。
SENTINEL_CODEX_RESET_LEASE_SECONDS=180
# 通知失败指数退避与终止上限。
SENTINEL_CODEX_RESET_RETRY_BASE_SECONDS=10
SENTINEL_CODEX_RESET_RETRY_MAX_SECONDS=900
SENTINEL_CODEX_RESET_DELIVERY_MAX_ATTEMPTS=8
# HTML 只作交叉验证/降级，最多每小时抓取一次。
SENTINEL_CODEX_RESET_HTML_POLL_SECONDS=3600
# 可选本机参考账号只读确认：只匹配已有 announced/delayed，绝不单独创建事件。
# 启用时将现有 Codex CLI 和 auth.json 分别单文件只读挂载到下列容器路径；
# 不要把宿主机路径、auth.json 内容或任何凭证写入仓库。
SENTINEL_CODEX_RESET_REFERENCE_ENABLED=false
SENTINEL_CODEX_RESET_REFERENCE_CLI=/usr/local/bin/codex-reference
SENTINEL_CODEX_RESET_REFERENCE_CODEX_HOME=/run/codex-reference
SENTINEL_CODEX_RESET_REFERENCE_RUNTIME_HOME=/tmp/watchmend-codex-reference
# 单次官方 app-server 只读额度请求超时。
SENTINEL_CODEX_RESET_REFERENCE_TIMEOUT_SECONDS=20
# 10000 分钟可排除 5 小时窗口并保留当前七日（10080 分钟）窗口。
SENTINEL_CODEX_RESET_REFERENCE_MIN_WINDOW_MINUTES=10000
# 仅接受最近 6 小时内开始的新七日窗口，且仍需和已有预告窗口相关联。
SENTINEL_CODEX_RESET_REFERENCE_MAX_RESET_AGE_SECONDS=21600


# 公开数据源；只在上游迁移时覆盖。
SENTINEL_CODEX_RESET_RADAR_CURRENT_URL=https://codex-reset-radar.pages.dev/current.json
SENTINEL_CODEX_RESET_RSS_URL=https://codexradar.com/feed.xml
SENTINEL_CODEX_RESET_FEED_URL=https://codex-reset.com/api/feed
SENTINEL_CODEX_RESET_TIMELINE_URL=https://codex-reset.com/api/timeline
SENTINEL_CODEX_RESET_HTML_URL=https://codexreset.org/


# ============================================================
# 以下是 docker compose 部署变量(不是应用配置)
# ============================================================
# 接入的外部 docker 网络名(docker network ls 查看;两者可以相同):
# egress=能出网/可达反代的网络;metrics=prometheus/loki 所在网络。
# 没有现成网络就先 docker network create sentinel-egress sentinel-metrics
SENTINEL_EGRESS_NETWORK=sentinel-egress
SENTINEL_METRICS_NETWORK=sentinel-metrics
# 宿主机 pg_dump 备份目录(挂载为只读);没有备份保持默认即可(空目录=检查自动跳过)
SENTINEL_BACKUP_HOST_DIR=./backups
