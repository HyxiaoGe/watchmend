# 飞书 #外部依赖状态群 自定义机器人(开启「签名校验」安全模式)
FEISHU_VENDOR_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_ME
FEISHU_VENDOR_SIGN_SECRET=REPLACE_ME

# 启用厂商(逗号分隔);v1 五家
SENTINEL_PROVIDERS=anthropic,openai,github,cloudflare,google_cloud
SENTINEL_POLL_INTERVAL=60
SENTINEL_INCIDENT_VERBOSITY=phase
SENTINEL_FAIL_THRESHOLD=3
SENTINEL_DB_PATH=/data/sentinel.db

# Phase 3 编排 API 写端点 token;空=不鉴权(仅容器网内可达时可接受);部署时必须设随机值
SENTINEL_DIAG_TOKEN=

# docker compose 接入的外部网络名(docker network ls 查看;两者可相同)
# egress=能出网/可达反代的网络;metrics=prometheus/loki 所在网络
SENTINEL_EGRESS_NETWORK=sentinel-egress
SENTINEL_METRICS_NETWORK=sentinel-metrics

# hygiene 备份新鲜度检查的宿主机 pg_dump 目录;无备份保持默认即可
SENTINEL_BACKUP_DIR=./backups
