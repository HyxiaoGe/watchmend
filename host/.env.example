# 宿主机编排脚本(diag_orchestrator / daily_summary / ops_mcp / remediate)的环境变量。
# 与脚本同目录放一份 .env(chmod 600),_load_env 会自动加载。
#
# 注意:这条宿主机 agent 编排路径与容器内直连 LLM(容器 .env 的 LLM_BASE_URL)二选一,
# 两路同开会抢同一个 pending 诊断队列、重复诊断重复发卡。

# sentinel 编排 API(容器 host-published 端口)
SENTINEL_URL=http://127.0.0.1:8765
# 写端点鉴权 token:与容器侧 .env 的 SENTINEL_DIAG_TOKEN 一致
SENTINEL_DIAG_TOKEN=

# agent runner 可执行文件(LLM 诊断层用)
OPENCLAW_BIN=openclaw

# ops_mcp 经 docker inspect 解析 Prometheus 容器 IP:按你的容器/网络名设置
# (docker ps / docker network ls 查看)
OPS_PROM_CONTAINER=prometheus
OPS_PROM_NETWORK=prometheus-stack_default

# 恢复包装脚本目录(层 2):默认=remediate.py 同级 recovery/;按实际部署路径覆盖
# SENTINEL_RECOVERY_DIR=/opt/sentinel-host/recovery
